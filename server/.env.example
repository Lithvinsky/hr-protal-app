MONGO_URI=
# Required for JWT (employee + User login). Use a long random string in production.
JWT_SECRET=
# Optional, default 7d — e.g. 8h, 7d, 30d
# JWT_EXPIRES_IN=7d

PORT=5000

# Optional: custom frontend domain(s), comma-separated. Vercel *.vercel.app is allowed automatically.
CLIENT_ORIGIN=https://your-app.vercel.app

# After MONGO_URI + JWT_SECRET: npm run seed
